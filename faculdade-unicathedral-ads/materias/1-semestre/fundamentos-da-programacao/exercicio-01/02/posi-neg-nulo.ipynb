   "source": [
    "### 02. Escreva um algoritmo para determinar se um dado número N (recebido através do teclado) é POSITIVO, NEGATIVO ou NULO."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "2 É Positivo.\n"
     ]
    }
   ],
   "source": [
    "n = int(input(\"Digite um número: \"))\n",
    "if n >= 1:\n",
    "    print(f\"{n} É Positivo.\")\n",
    "elif n == 0:\n",
    "    print(f\"{n} É Nulo.\")\n",
    "else:\n",
    "    print(f\"{n} É Negativo.\")\n"
   ]
  }
