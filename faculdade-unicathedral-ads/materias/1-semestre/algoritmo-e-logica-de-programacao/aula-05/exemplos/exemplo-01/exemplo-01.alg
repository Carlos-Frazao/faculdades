algoritmo "Exemplo_01"
var
    numero: real
inicio
    numero <- 0
    enquanto numero >= 0 faca
        escreva("Digite um número positivo ou negativo: ")
        leia(numero)
        se (numero > 10) e (numero < 50) entao 
            escreval(numero)
        fimse
    fimenquanto 
fimalgoritmo