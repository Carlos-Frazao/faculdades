algoritmo "Vetor_Par"
var
    par : vetor[0..4] de inteiro
    indice : inteiro
inicio
    par [0] <- 0
    par [1] <- 2 
    par [2] <- 4
    par [3] <- 6
    par [4] <- 8
    
    escreva(par[0])
    escreva(par[1])
    escreva(par[2])
    escreva(par[3])
    escreva(par[4])

fimalgoritmo