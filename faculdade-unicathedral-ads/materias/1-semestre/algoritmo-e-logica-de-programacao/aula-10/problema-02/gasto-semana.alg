algoritmo "Gasto_Semana"
var
    dias: vetor[0..6] de real
    gasto: vetor[0..6] de real 
    i: inteiro
inicio
    dias[0] <- "Segunda-feira"
    dias[1]
    dias[2]
    dias[3]
    dias[4]
    dias[5]
    dias[6]
    para i de 0 ate 6 faca
        escreva("Informe os gastos da ",dias[i],": ")
        leia(gasto)
    fimpara 
fimalgoritmo