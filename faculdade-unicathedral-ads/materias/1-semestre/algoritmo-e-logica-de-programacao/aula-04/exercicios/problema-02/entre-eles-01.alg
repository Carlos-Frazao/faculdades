algoritmo "Entre_Eles_01"
var
    n1, n2, cont: inteiro
inicio
    escreva("Informe o primeiro valor: ")
    leia(n1)
    escreva("Informe o segundo valor: ")
    leia(n2)
    // Irá contar de n1 + 1 até n2 - 1, ou seja irá exibir todos os números entre n1 e n2.
    para cont de n1 + 1 ate n2 - 1 faca
        escreva(cont)
    fimpara
fimalgoritmo